# Phase 1 needs no secrets. Phase 2 collectors will use:
# HIBP_API_KEY=            # HaveIBeenPwned domain-search API key
# ANTHROPIC_API_KEY=       # LLM triage/summary agent (Phase 2)

# --email flag: sends the digest only when there are alerts or a collector failure.
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=           # app password, never your real account password
# EMAIL_FROM=              # defaults to SMTP_USER if unset
# EMAIL_TO=you@example.com # comma-separated for multiple recipients
